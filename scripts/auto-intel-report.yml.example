name: Auto OSINT & Strategic Spillover Pipeline

on:
  schedule:
    - cron: '0 0 * * *'
  push:
    paths:
      - 'reports_inbox/*.pdf'
  workflow_dispatch:

jobs:
  extract-osint:
    runs-on: ubuntu-latest
    permissions:
      contents: write
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: '3.11'
      - run: pip install pypdf && python scripts/osint_pdf_pipeline.py
      - run: |
          git config user.name "OSINT-Strategic-Bot"
          git config user.email "bot@users.noreply.github.com"
          git add public/data/osint-intelligence.geojson public/data/spillover-ledger.json public/data/spillover-budget-ledger.json
          git commit -m "chore(osint): update strategic geojson & dual-pillar budget ledger" || exit 0
          git push
